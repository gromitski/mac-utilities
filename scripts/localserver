#!/usr/bin/env python3
"""
localserver: Local Wi-Fi HTTP Server with Terminal QR Code
----------------------------------------------------------
Spins up a lightweight HTTP server in the current directory and renders
a scannable QR code directly in the terminal so you can browse files or
test web apps on your phone/tablet in 1 second over local Wi-Fi.

Usage:
  localserver              Serve current folder on default port (8000 or next free)
  localserver 3000         Serve on specific port
  localserver /path/to/dir Serve a custom folder
"""

import argparse
import functools
import http.server
import os
import shutil
import socket
import socketserver
import subprocess
import sys


def find_qrencode() -> str:
    """Find the qrencode binary."""
    path = shutil.which("qrencode")
    if path:
        return path
    for fallback in ["/opt/homebrew/bin/qrencode", "/usr/local/bin/qrencode", "/usr/bin/qrencode"]:
        if os.path.exists(fallback) and os.access(fallback, os.X_OK):
            return fallback
    return ""


def render_terminal_qr(url: str) -> str:
    """Render a rock-solid, camera-scannable QR code using qrencode."""
    qrencode_bin = find_qrencode()
    if qrencode_bin:
        try:
            # Use ANSI256 for solid background blocks with zero font line-height gaps
            res = subprocess.run(
                [qrencode_bin, "-t", "ANSI256", "-m", "2", "-o", "-", url],
                capture_output=True,
                text=True,
            )
            if res.returncode == 0 and res.stdout.strip():
                return res.stdout
        except Exception:
            pass

    # Fallback to UTF8
    if qrencode_bin:
        try:
            res = subprocess.run(
                [qrencode_bin, "-t", "UTF8", "-m", "2", "-o", "-", url],
                capture_output=True,
                text=True,
            )
            if res.returncode == 0 and res.stdout.strip():
                return res.stdout
        except Exception:
            pass

    return f"\n  Open on mobile: {url}\n"


def get_local_ip() -> str:
    """Get the Mac's active Wi-Fi / LAN IP address."""
    for iface in ["en0", "en1", "en2", "bridge0"]:
        try:
            res = subprocess.run(["ipconfig", "getifaddr", iface], capture_output=True, text=True)
            ip = res.stdout.strip()
            if ip and not ip.startswith("127."):
                return ip
        except Exception:
            pass

    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"


def find_free_port(start_port: int = 8000) -> int:
    """Find the next available TCP port starting from start_port."""
    port = start_port
    while port < 65535:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            if s.connect_ex(("0.0.0.0", port)) != 0:
                return port
            port += 1
    return start_port


def main():
    parser = argparse.ArgumentParser(
        description="localserver: Serve local directory over Wi-Fi with terminal QR code",
        usage="localserver [directory] [port]",
    )
    parser.add_argument("directory", nargs="?", default=".", help="Directory to serve (default: current directory)")
    parser.add_argument("port", nargs="?", type=int, default=None, help="Port to serve on (default: 8000)")

    args = parser.parse_args()

    # Handle directory vs port order
    target_dir = "."
    port_arg = None

    if args.directory:
        if args.directory.isdigit():
            port_arg = int(args.directory)
            target_dir = "."
        else:
            target_dir = args.directory

    if args.port:
        port_arg = args.port

    target_dir = os.path.abspath(os.path.expanduser(target_dir))
    if not os.path.exists(target_dir):
        print(f"\033[1;31mError:\033[0m Directory does not exist: {target_dir}", flush=True)
        sys.exit(1)

    port = port_arg if port_arg else find_free_port(8000)
    local_ip = get_local_ip()
    url = f"http://{local_ip}:{port}"

    print(f"\n📱 \033[1mLocal Wi-Fi Server Active\033[0m", flush=True)
    print("──────────────────────────────────────────────────────────────────────────", flush=True)
    print(f"📁 Serving Directory : \033[33m{target_dir}\033[0m", flush=True)
    print(f"🌐 Local Address     : \033[1;32m{url}\033[0m", flush=True)
    print(f"💻 Loopback Address  : http://localhost:{port}", flush=True)
    print("──────────────────────────────────────────────────────────────────────────", flush=True)
    print("\nScan with your phone camera on the same Wi-Fi:\n", flush=True)

    print(render_terminal_qr(url), flush=True)

    print("\033[90mPress Ctrl + C to stop the server.\033[0m\n", flush=True)

    handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory=target_dir)

    class ReuseTCPServer(socketserver.TCPServer):
        allow_reuse_address = True

    try:
        with ReuseTCPServer(("0.0.0.0", port), handler) as httpd:
            httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n\n🛑 \033[33mServer stopped.\033[0m\n", flush=True)
        sys.exit(0)


if __name__ == "__main__":
    main()
