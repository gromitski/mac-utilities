#!/usr/bin/env python3
"""
serve-qr: Local Wi-Fi HTTP Server with Terminal QR Code
-------------------------------------------------------
Spins up a lightweight HTTP server in the current directory and renders
a scannable QR code directly in the terminal so you can browse files or
test web apps on your phone/tablet in 1 second over local Wi-Fi.

Usage:
  serve-qr              Serve current folder on default port (8000 or next free)
  serve-qr 3000         Serve on specific port
  serve-qr /path/to/dir Serve a custom folder
"""

import argparse
import functools
import http.server
import os
import socket
import socketserver
import subprocess
import sys


def get_local_ip() -> str:
    """Get the Mac local Wi-Fi / LAN IP address."""
    # Method 1: macOS native ipconfig
    for iface in ["en0", "en1", "en2", "bridge0"]:
        try:
            res = subprocess.run(["ipconfig", "getifaddr", iface], capture_output=True, text=True)
            ip = res.stdout.strip()
            if ip and not ip.startswith("127."):
                return ip
        except Exception:
            pass

    # Method 2: Socket probe
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"


def find_free_port(start_port: int = 8000) -> int:
    """Find the next available TCP port starting from start_port."""
    port = start_port
    while port < 65535:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            if s.connect_ex(("0.0.0.0", port)) != 0:
                return port
            port += 1
    return start_port


def print_ascii_qr(url: str):
    """
    Render a clean, scannable QR code in the terminal using UTF-8 blocks.
    Uses qrencode CLI if installed, or falls back to a compact pure-Python QR generator.
    """
    # 1. Check if qrencode is installed on Mac
    if shutil.which("qrencode"):
        try:
            res = subprocess.run(["qrencode", "-t", "UTF8", url], capture_output=True, text=True)
            if res.returncode == 0 and res.stdout:
                print(res.stdout)
                return
        except Exception:
            pass

    # 2. Check if python qrcode module is available
    try:
        import qrcode
        qr = qrcode.QRCode(border=2)
        qr.add_data(url)
        qr.make(fit=True)
        # Print using unicode half-blocks for compact rendering
        matrix = qr.get_matrix()
        for r in range(0, len(matrix), 2):
            line = ""
            for c in range(len(matrix[0])):
                top = matrix[r][c]
                bot = matrix[r + 1][c] if r + 1 < len(matrix) else False
                if top and bot:
                    line += "█"
                elif top and not bot:
                    line += "▀"
                elif not top and bot:
                    line += "▄"
                else:
                    line += " "
            print("  " + line)
        return
    except ImportError:
        pass

    # 3. Fast fallback: Print clickable link & URL box
    print(f"\n  ┌──────────────────────────────────────────────────────────┐")
    print(f"  │  Scan / Open on your Mobile Device:                      │")
    print(f"  │  \033[1;36m{url:<54}\033[0m  │")
    print(f"  └──────────────────────────────────────────────────────────┘\n")


import shutil

def main():
    parser = argparse.ArgumentParser(
        description="serve-qr: Serve local directory over Wi-Fi with terminal QR code",
        usage="serve-qr [directory] [port]",
    )
    parser.add_argument("directory", nargs="?", default=".", help="Directory to serve (default: current directory)")
    parser.add_argument("port", nargs="?", type=int, default=None, help="Port to serve on (default: 8000)")

    args = parser.parse_args()

    target_dir = os.path.abspath(os.path.expanduser(args.directory))
    if not os.path.exists(target_dir):
        print(f"\033[1;31mError:\033[0m Directory does not exist: {target_dir}")
        sys.exit(1)

    port = args.port if args.port else find_free_port(8000)
    local_ip = get_local_ip()
    url = f"http://{local_ip}:{port}"

    print(f"\n📱 \033[1mLocal Wi-Fi Server Active\033[0m")
    print("──────────────────────────────────────────────────────────────────────────")
    print(f"📁 Serving Directory : \033[33m{target_dir}\033[0m")
    print(f"🌐 Local Address     : \033[1;32m{url}\033[0m")
    print(f"💻 Loopback Address  : http://localhost:{port}")
    print("──────────────────────────────────────────────────────────────────────────")
    print("\nScan with your phone camera on the same Wi-Fi:\n")

    print_ascii_qr(url)

    print("\033[90mPress Ctrl + C to stop the server.\033[0m\n")

    handler = functools.partial(http.server.SimpleHTTPRequestHandler, directory=target_dir)

    class ReuseTCPServer(socketserver.TCPServer):
        allow_reuse_address = True

    try:
        with ReuseTCPServer(("0.0.0.0", port), handler) as httpd:
            httpd.serve_forever()
    except KeyboardInterrupt:
        print("\n\n🛑 \033[33mServer stopped.\033[0m\n")
        sys.exit(0)


if __name__ == "__main__":
    main()
