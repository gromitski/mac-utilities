#!/usr/bin/env python3
"""
Clean - Unified Mac Housekeeping CLI & Alfred Trigger
------------------------------------------------------
Orchestrates screenshot, download, desktop, app leftovers, clipboard, branches, cache, and URL housekeeping.

Usage:
  clean                    Run standard file housekeeping (Screenshots + Downloads + Desktop)
  clean screenshots        Run only screenshot housekeeping
  clean downloads          Run only downloads housekeeping
  clean desktop            Run only desktop housekeeping
  clean app-leftovers      Scan and safely trash orphaned data from uninstalled apps
  clean clipboard          Instantly wipe clipboard memory (privacy flush)
  clean clipboard text     Sanitize clipboard text (strip rich formatting & zero-width spaces)
  clean clipboard status   Inspect clipboard data types and length
  clean branches           Prune merged and dead Git branches in current repo
  clean branches --all     Audit stale branches across all workspace repositories
  clean deep / --deep      Run Screenshots + Downloads + Desktop + App Leftovers + Caches
  clean cache              Run only the safe system cache reclaimer
  clean url [link]         Strip tracking parameters from copied clipboard URL or provided link
  clean --dry-run / -n     Preview actions across all utilities without touching files
  clean --notify           Run and display a native macOS notification banner (for Alfred)
  clean --alfred-filter    Output Alfred 5 Script Filter JSON
"""

import argparse
import json
import os
import subprocess
import sys

# Ensure scripts directory is in sys.path for direct module import
SCRIPTS_DIR = os.path.dirname(os.path.abspath(__file__))
if SCRIPTS_DIR not in sys.path:
    sys.path.insert(0, SCRIPTS_DIR)

from screenshot_housekeeping import organize_screenshots
from downloads_housekeeping import organize_downloads
from desktop_housekeeping import organize_desktop
from system_cache_cleaner import clean_system_caches, format_bytes
from url_cleaner import clean_clipboard_url
from app_leftovers_cleaner import clean_app_leftovers, format_bytes as format_leftover_bytes
from clipboard_cleaner import clean_clipboard
from git_branch_cleaner import clean_branches_in_repo, scan_workspace as scan_branches_workspace


def send_macos_notification(title: str, subtitle: str, message: str):
    """Send a native macOS notification banner."""
    apple_script = f'''display notification "{message}" with title "{title}" subtitle "{subtitle}" sound name "default"'''
    subprocess.run(["osascript", "-e", apple_script], capture_output=True)


def output_alfred_filter(query: str = ""):
    """Generate JSON for Alfred Script Filter dropdown."""
    query = (query or "").strip().lower()

    all_items = [
        {
            "uid": "clean-all",
            "title": "Clean All (Screenshots + Downloads + Desktop)",
            "subtitle": "Organize screenshots, downloads, and desktop files into structured archives",
            "arg": "all",
            "autocomplete": "all",
            "valid": True,
        },
        {
            "uid": "clean-screenshots",
            "title": "Clean Screenshots",
            "subtitle": "Organize all loose screenshots into YYYY-MM-DD day folders",
            "arg": "screenshots",
            "autocomplete": "screenshots",
            "valid": True,
        },
        {
            "uid": "clean-downloads",
            "title": "Clean Downloads",
            "subtitle": "Organize loose downloads into monthly archives and purge installers",
            "arg": "downloads",
            "autocomplete": "downloads",
            "valid": True,
        },
        {
            "uid": "clean-desktop",
            "title": "Clean Desktop",
            "subtitle": "Sweep loose desktop files into monthly archive folder (zero deletions)",
            "arg": "desktop",
            "autocomplete": "desktop",
            "valid": True,
        },
        {
            "uid": "clean-app-leftovers",
            "title": "Clean App Leftovers",
            "subtitle": "Safely find and clean orphaned support data from uninstalled apps",
            "arg": "app-leftovers",
            "autocomplete": "app-leftovers",
            "valid": True,
        },
        {
            "uid": "clean-branches",
            "title": "Clean Git Branches",
            "subtitle": "Safely prune merged and dead remote-tracking branches in current repo",
            "arg": "branches",
            "autocomplete": "branches",
            "valid": True,
        },
        {
            "uid": "clean-clipboard",
            "title": "Clean Clipboard (Flush / Wipe)",
            "subtitle": "Instantly clear sensitive passwords, tokens, or private data from memory",
            "arg": "clipboard",
            "autocomplete": "clipboard",
            "valid": True,
        },
        {
            "uid": "clean-clipboard-text",
            "title": "Clean Clipboard (Plain Text)",
            "subtitle": "Strip rich styling, smart quotes, and invisible zero-width spaces",
            "arg": "clipboard text",
            "autocomplete": "clipboard text",
            "valid": True,
        },
        {
            "uid": "clean-url",
            "title": "Clean URL (Clipboard)",
            "subtitle": "Strip tracking clutter (utm_*, fbclid, si, ref) from copied link",
            "arg": "url",
            "autocomplete": "url",
            "valid": True,
        },
        {
            "uid": "clean-deep",
            "title": "Clean Deep (Files + Leftovers + Cache Reclaimer)",
            "subtitle": "Screenshots, Downloads, Desktop, App Leftovers + safe developer cache purge",
            "arg": "deep",
            "autocomplete": "deep",
            "valid": True,
        },
        {
            "uid": "clean-cache",
            "title": "Clean Caches Only",
            "subtitle": "Safely purge Homebrew, npm, pip, and developer build caches",
            "arg": "cache",
            "autocomplete": "cache",
            "valid": True,
        },
    ]

    if query:
        filtered = [
            item for item in all_items
            if query in item["title"].lower() or query in item["arg"].lower() or query in item["autocomplete"].lower()
        ]
        items_to_show = filtered if filtered else all_items
    else:
        items_to_show = all_items

    print(json.dumps({"items": items_to_show}, indent=2))
    sys.exit(0)


def main():
    parser = argparse.ArgumentParser(
        description="Clean: Unified Mac Housekeeping CLI",
        usage="clean [target] [extra_args...] [options]",
    )
    parser.add_argument(
        "target",
        nargs="?",
        default="all",
        help="Target to clean: 'all' (default), 'screenshots', 'downloads', 'desktop', 'app-leftovers', 'branches', 'clipboard', 'cache', 'deep', 'url', or a direct URL",
    )
    parser.add_argument(
        "extra_args",
        nargs="*",
        help="Optional arguments (e.g. 'text' or 'status' for clipboard, '--all' for branches, or a direct URL for url cleaner)",
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="Simulate actions without moving files or trashing anything",
    )
    parser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="Bypass interactive confirmation prompts",
    )
    parser.add_argument(
        "-a",
        "--all",
        action="store_true",
        help="Target all items or workspace repositories (e.g. 'clean branches --all')",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Display verbose details for each item",
    )
    parser.add_argument(
        "--deep",
        action="store_true",
        help="Include deep cache clearing & developer space reclaimers",
    )
    parser.add_argument(
        "--notify",
        action="store_true",
        help="Send a native macOS notification upon completion (for Alfred / background)",
    )
    parser.add_argument(
        "--alfred-filter",
        nargs="?",
        const="",
        help="Generate Alfred Script Filter JSON",
    )

    args = parser.parse_args()

    # Handle Alfred Script Filter query
    if args.alfred_filter is not None:
        output_alfred_filter(args.alfred_filter)

    # Normalize target argument
    target = args.target
    input_url = None

    # Check if target itself is a URL (e.g. `clean https://...`)
    if target.startswith("http://") or target.startswith("https://"):
        input_url = target
        target = "url"
    elif target == "url":
        if args.extra_args:
            input_url = args.extra_args[0]
    elif target in ("-n", "--dry-run"):
        args.dry_run = True
        target = "all"
    elif target in ("deep", "--deep"):
        args.deep = True
        target = "deep"

    # Scenario: Clean URL (Standalone clipboard or direct URL utility)
    if target == "url":
        cleaned, original, modified = clean_clipboard_url(input_url)
        if not original:
            print("\n⚠️  Clipboard is empty or contains no valid URL.\n")
            if args.notify:
                send_macos_notification("Clean URL", "No URL Found", "Clipboard is empty or not a link.")
            return

        print("\n🔗 \033[1mURL Tracker Cleaner\033[0m")
        print("──────────────────────────────────────────────────────────────────────────")
        print(f"\033[90mOriginal:\033[0m {original}")
        print(f"\033[32mCleaned :\033[0m \033[1m{cleaned}\033[0m")
        print("──────────────────────────────────────────────────────────────────────────")

        if modified:
            print("✓ \033[32mTracking parameters stripped and clean URL copied to clipboard!\033[0m\n")
            if args.notify:
                send_macos_notification("Clean URL Copied", "Tracking parameters removed", cleaned)
        else:
            print("✓ \033[90mURL was already clean (copied to clipboard).\033[0m\n")
            if args.notify:
                send_macos_notification("Clean URL", "Already clean (copied to clipboard)", cleaned)
        return

    # Scenario: Clean Git Branches (Standalone ONLY - Never in automated clean or clean deep)
    if target in ("branches", "branch"):
        force_mode = args.force or "--force" in args.extra_args or "-f" in args.extra_args
        all_mode = args.all or "--all" in args.extra_args or "-a" in args.extra_args or (len(args.extra_args) > 0 and args.extra_args[0].lower() == "all")
        if all_mode:
            scan_branches_workspace()
        else:
            repo_target = "."
            if args.extra_args and not args.extra_args[0].startswith("-") and args.extra_args[0].lower() != "all":
                repo_target = args.extra_args[0]
            deleted = clean_branches_in_repo(
                repo_path=repo_target,
                dry_run=args.dry_run,
                force=force_mode,
                verbose=args.verbose,
            )
            if args.notify and not args.dry_run and deleted > 0:
                send_macos_notification("Clean Git Branches", "Branches Pruned", f"Deleted {deleted} stale local branch(es).")
        return

    # Scenario: Clean Clipboard (Standalone)
    if target in ("clipboard", "cb"):
        cb_mode = args.extra_args[0].lower() if args.extra_args else "wipe"
        success = clean_clipboard(mode=cb_mode, dry_run=args.dry_run, verbose=args.verbose)
        if args.notify and success and not args.dry_run:
            if cb_mode in ("text", "plain", "sanitize"):
                send_macos_notification("Clean Clipboard", "Text Sanitized", "Clean plain text copied to clipboard.")
            elif cb_mode not in ("status", "info"):
                send_macos_notification("Clean Clipboard", "Memory Cleared", "Sensitive data wiped from clipboard.")
        return

    # Scenario: Clean App Leftovers (Standalone)
    if target in ("app-leftovers", "leftovers", "app_leftovers"):
        force_mode = args.force or "--force" in args.extra_args or "-f" in args.extra_args
        reclaimed = clean_app_leftovers(
            dry_run=args.dry_run,
            force=force_mode,
            verbose=args.verbose,
        )
        if args.notify and not args.dry_run and reclaimed > 0:
            send_macos_notification("App Leftovers Cleaned", "Orphaned data trashed", f"Reclaimed {format_leftover_bytes(reclaimed)}")
        return

    # Standard File & System Housekeeping
    mode_str = " (DRY-RUN)" if args.dry_run else ""
    deep = target == "deep" or args.deep
    # Calculate step count
    step_total = 3 if not deep else 5
    step = 0

    print(f"\n🧹 \033[1mStarting Mac Housekeeping{mode_str}...\033[0m\n")

    summary_messages = []
    has_errors = False

    # 1. Screenshots (run for 'all', 'deep', or 'screenshots')
    if target in ("all", "deep", "screenshots"):
        step += 1
        print(f"\033[1;34m[{step}/{step_total}] 📸 Cleaning Screenshots...\033[0m")
        try:
            organize_screenshots(
                base_dir="~/Pictures/screenshots",
                dry_run=args.dry_run,
                verbose=args.verbose,
            )
            summary_messages.append("Screenshots organized")
        except Exception as e:
            print(f"   \033[1;31mError organizing screenshots:\033[0m {e}")
            has_errors = True

    # 2. Downloads (run for 'all', 'deep', or 'downloads')
    if target in ("all", "deep", "downloads"):
        step += 1
        print(f"\033[1;34m[{step}/{step_total}] 📥 Cleaning Downloads...\033[0m")
        try:
            organize_downloads(
                downloads_dir="~/Downloads",
                dry_run=args.dry_run,
                verbose=args.verbose,
            )
            summary_messages.append("Downloads organized")
        except Exception as e:
            print(f"   \033[1;31mError organizing downloads:\033[0m {e}")
            has_errors = True

    # 3. Desktop (run for 'all', 'deep', or 'desktop')
    if target in ("all", "deep", "desktop"):
        step += 1
        print(f"\033[1;34m[{step}/{step_total}] 🖥️  Cleaning Desktop...\033[0m")
        try:
            moved_count = organize_desktop(
                desktop_dir="~/Desktop",
                dry_run=args.dry_run,
                verbose=args.verbose,
            )
            if moved_count > 0:
                summary_messages.append(f"Desktop: {moved_count} items organized")
            else:
                summary_messages.append("Desktop clean")
        except Exception as e:
            print(f"   \033[1;31mError organizing desktop:\033[0m {e}")
            has_errors = True

    # 4. App Leftovers (ONLY in 'deep')
    if deep:
        step += 1
        print(f"\033[1;34m[{step}/{step_total}] 👻 Scanning Orphaned App Leftovers (>60d unmodified)...\033[0m")
        try:
            reclaimed = clean_app_leftovers(
                dry_run=args.dry_run,
                force=True,  # in deep clean, automated execution of whitelisted/recency-checked orphans
                verbose=args.verbose,
            )
            if not args.dry_run and reclaimed > 0:
                summary_messages.append(f"Leftovers: reclaimed {format_leftover_bytes(reclaimed)}")
            else:
                summary_messages.append("Leftovers clean")
        except Exception as e:
            print(f"   \033[1;31mError cleaning app leftovers:\033[0m {e}")
            has_errors = True

    # 5. Safe System Caches (ONLY in 'deep' or 'cache')
    if target in ("deep", "cache") or args.deep:
        step += 1
        print(f"\033[1;34m[{step}/{step_total}] 🚀 Reclaiming System & Developer Caches...\033[0m")
        try:
            reclaimed_bytes = clean_system_caches(
                dry_run=args.dry_run,
                verbose=args.verbose,
            )
            if not args.dry_run and reclaimed_bytes > 0:
                summary_messages.append(f"Caches: reclaimed {format_bytes(reclaimed_bytes)}")
            else:
                summary_messages.append("Caches cleaned")
        except Exception as e:
            print(f"   \033[1;31mError cleaning caches:\033[0m {e}")
            has_errors = True

    if has_errors:
        print("\033[1;31m⚠️  Housekeeping completed with warnings/errors.\033[0m\n")
        if args.notify:
            send_macos_notification("Mac Housekeeping", "Completed with warnings", "Check terminal logs.")
    else:
        print("\033[1;32m✨ All clean!\033[0m\n")
        if args.notify:
            notif_msg = " & ".join(summary_messages) if summary_messages else "Done."
            target_label = f" ({target.capitalize()})" if target in ("screenshots", "downloads", "desktop", "app-leftovers", "deep", "cache") else ""
            send_macos_notification(f"Mac Housekeeping Complete{target_label}", "Tidied up successfully", notif_msg)


if __name__ == "__main__":
    main()
