#!/usr/bin/env python3
"""
Clean - Unified Mac Housekeeping CLI & Alfred Trigger
------------------------------------------------------
Orchestrates screenshot and download housekeeping in a single command.
Usage:
  clean                 Run standard cleanup (screenshots + downloads)
  clean --dry-run / -n  Preview actions across all utilities without touching files
  clean screenshots     Run only screenshot housekeeping
  clean downloads       Run only downloads housekeeping
  clean --deep          Run standard cleanup + deep system & developer cache purges
  clean --notify        Run and display a native macOS notification banner (for Alfred)
  clean --alfred-filter Output Alfred 5 Script Filter JSON
"""

import argparse
import json
import os
import subprocess
import sys

# Ensure scripts directory is in sys.path for direct module import
SCRIPTS_DIR = os.path.dirname(os.path.abspath(__file__))
if SCRIPTS_DIR not in sys.path:
    sys.path.insert(0, SCRIPTS_DIR)

from screenshot_housekeeping import organize_screenshots
from downloads_housekeeping import organize_downloads


def send_macos_notification(title: str, subtitle: str, message: str):
    """Send a native macOS notification banner."""
    apple_script = f'''display notification "{message}" with title "{title}" subtitle "{subtitle}" sound name "default"'''
    subprocess.run(["osascript", "-e", apple_script], capture_output=True)


def output_alfred_filter(query: str = ""):
    """Generate JSON for Alfred Script Filter dropdown."""
    query = (query or "").strip().lower()

    all_items = [
        {
            "uid": "clean-all",
            "title": "Clean All (Screenshots + Downloads)",
            "subtitle": "Organize screenshots into day folders and downloads into monthly archives",
            "arg": "all",
            "autocomplete": "all",
            "valid": True,
        },
        {
            "uid": "clean-screenshots",
            "title": "Clean Screenshots",
            "subtitle": "Organize all loose screenshots into YYYY-MM-DD day folders",
            "arg": "screenshots",
            "autocomplete": "screenshots",
            "valid": True,
        },
        {
            "uid": "clean-downloads",
            "title": "Clean Downloads",
            "subtitle": "Organize loose downloads into monthly archives and purge installers",
            "arg": "downloads",
            "autocomplete": "downloads",
            "valid": True,
        },
        {
            "uid": "clean-deep",
            "title": "Clean Deep (System & Dev Caches)",
            "subtitle": "Run standard cleanups + deep system cache purges",
            "arg": "--deep",
            "autocomplete": "deep",
            "valid": True,
        },
    ]

    if query:
        filtered = [
            item for item in all_items
            if query in item["title"].lower() or query in item["arg"].lower() or query in item["autocomplete"].lower()
        ]
        items_to_show = filtered if filtered else all_items
    else:
        items_to_show = all_items

    print(json.dumps({"items": items_to_show}, indent=2))
    sys.exit(0)


def main():
    parser = argparse.ArgumentParser(
        description="Clean: Unified Mac Housekeeping CLI",
        usage="clean [target] [options]",
    )
    parser.add_argument(
        "target",
        nargs="?",
        choices=["all", "screenshots", "downloads", "--deep", "-n", "--dry-run"],
        default="all",
        help="Target to clean: 'all' (default), 'screenshots', 'downloads', or '--deep'",
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="Simulate actions without moving files or trashing anything",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Display verbose details for each item",
    )
    parser.add_argument(
        "--deep",
        action="store_true",
        help="Include deep cache clearing & developer space reclaimers",
    )
    parser.add_argument(
        "--notify",
        action="store_true",
        help="Send a native macOS notification upon completion (for Alfred / background)",
    )
    parser.add_argument(
        "--alfred-filter",
        nargs="?",
        const="",
        help="Generate Alfred Script Filter JSON",
    )

    args = parser.parse_args()

    # Handle Alfred Script Filter query
    if args.alfred_filter is not None:
        output_alfred_filter(args.alfred_filter)

    # Normalize positional argument flags
    target = args.target
    if target in ("-n", "--dry-run"):
        args.dry_run = True
        target = "all"
    elif target == "--deep":
        args.deep = True
        target = "all"

    mode_str = " (DRY-RUN)" if args.dry_run else ""
    print(f"\n🧹 \033[1mStarting Mac Housekeeping{mode_str}...\033[0m\n")

    summary_messages = []
    has_errors = False

    # 1. Screenshots
    if target in ("all", "screenshots"):
        print("\033[1;34m[1/2] 📸 Cleaning Screenshots...\033[0m")
        try:
            organize_screenshots(
                base_dir="~/Pictures/screenshots",
                dry_run=args.dry_run,
                verbose=args.verbose,
            )
            summary_messages.append("Screenshots organized")
        except Exception as e:
            print(f"   \033[1;31mError organizing screenshots:\033[0m {e}")
            has_errors = True

    # 2. Downloads
    if target in ("all", "downloads"):
        print("\033[1;34m[2/2] 📥 Cleaning Downloads...\033[0m")
        try:
            organize_downloads(
                downloads_dir="~/Downloads",
                dry_run=args.dry_run,
                verbose=args.verbose,
            )
            summary_messages.append("Downloads organized")
        except Exception as e:
            print(f"   \033[1;31mError organizing downloads:\033[0m {e}")
            has_errors = True

    # 3. Deep mode (Future-proofed hook)
    if args.deep:
        print("\033[1;34m[Extra] 🚀 Deep System & Cache Cleanup...\033[0m")
        print("   • Deep cleanup module will be connected when system cache tool is added.\n")
        summary_messages.append("Deep cache purge simulated")

    if has_errors:
        print("\033[1;31m⚠️  Housekeeping completed with warnings/errors.\033[0m\n")
        if args.notify:
            send_macos_notification("Mac Housekeeping", "Completed with warnings", "Check terminal logs.")
    else:
        print("\033[1;32m✨ All clean!\033[0m\n")
        if args.notify:
            notif_msg = " & ".join(summary_messages) if summary_messages else "Done."
            target_label = f" ({target.capitalize()})" if target in ("screenshots", "downloads") else ""
            send_macos_notification(f"Mac Housekeeping Complete{target_label}", "Tidied up successfully", notif_msg)


if __name__ == "__main__":
    main()
